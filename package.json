{
  "name": "bannerfall-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "package:itch": "npm run build && mkdir -p release && rm -f release/bannerfall-web.zip && cd dist && zip -qr ../release/bannerfall-web.zip .",
    "itch": "npm run build && butler push dist ${ITCH_TARGET:?set ITCH_TARGET, e.g. yourname/bannerfall:html5}",
    "cover": "mkdir -p /tmp/bannerfall-ff && firefox --headless --no-remote --profile /tmp/bannerfall-ff --window-size=630,500 --screenshot \"$PWD/marketing/itch-cover.png\" http://localhost:5173/marketing/cover.html",
    "screenshots": "bash scripts/screenshots.sh",
    "gif": "python3 scripts/gif.py"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
